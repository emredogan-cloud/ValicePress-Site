# =============================================================================
# Digital Bookstore — Environment Variables Template
# =============================================================================
# Copy to `.env.local` for local development. NEVER commit real secrets.
#
# IMPORTANT — Vercel environments
# Every variable below must be configured separately for **each** Vercel
# environment: Preview, Staging, and Production
# (Vercel dashboard → Settings → Environment Variables, or `vercel env add`).
# Use isolated credentials per environment:
#   • a unique database (Neon branch / Supabase project) per env
#   • a unique R2 bucket pair (masters + artifacts) per env
#   • MoR sandbox keys for Preview/Staging, live keys only in Production
# (Roadmap §12 — "Separate buckets, DB branches, and MoR sandbox keys per environment.")
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public base URL of THIS deployment. Used for absolute links, OG tags,
# and the webhook callback URLs you register with the MoR / Auth provider.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Database — PostgreSQL (Neon or Supabase, per Roadmap §10 / PAST_DECISIONS)
# -----------------------------------------------------------------------------
# Pooled connection string used by the running app (PgBouncer / pooler endpoint).
#   Neon example:     postgresql://USER:PASSWORD@<host>-pooler.<region>.aws.neon.tech/DB?sslmode=require
#   Supabase example: postgresql://postgres.<ref>:PASSWORD@<host>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct (non-pooled) connection string used by migrations and long-running
# transactions (Prisma `migrate`, Drizzle). Required by both Neon and Supabase.
DIRECT_URL=


# -----------------------------------------------------------------------------
# Authentication — Clerk (preferred per ADR-8) OR Auth.js (NextAuth v5)
# Use EITHER block, not both. SUB-PR 0.5 commits to one.
# -----------------------------------------------------------------------------
# --- Option A: Clerk (managed; magic-link + social; fastest path) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=

# --- Option B: Auth.js (NextAuth v5; self-hosted; portable) ---
# AUTH_SECRET=                        # generate with `npx auth secret`
# AUTH_URL=                           # canonical URL, e.g. https://www.your-domain.com
# AUTH_RESEND_KEY=                    # magic-link via Resend
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=


# -----------------------------------------------------------------------------
# Admin allowlist (SUB-PR 4.1 — dashboard / catalog tools)
# -----------------------------------------------------------------------------
# Comma-separated list of email addresses permitted to use `/admin`. Emails
# are matched case-insensitively against the signed-in user's PRIMARY email.
# Empty / unset = nobody is admin (safe default; `/admin` shows a "not
# authorized" notice). Promotion / revocation is a redeploy.
#   Example: ADMIN_EMAILS=alice@example.com,bob@example.com
ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# Merchant of Record (MoR)
# Webhook secrets are mandatory: every webhook must be signature-verified
# (Roadmap §11 — "idempotent webhooks with signature verification").
# -----------------------------------------------------------------------------
# Payments — Lemon Squeezy (Merchant of Record since 2026-09-13).
# Paddle was retired the same day; its variables are gone, and its ids
# survive only as history in books.paddle_price_id and in past orders.
# ---------------------------------------------------------------------------
# Which adapter takes the money. Only 'lemonsqueezy' has one.
PAYMENT_PROVIDER=lemonsqueezy
# Settings » API in the dashboard, with the Valice Press store selected.
# MODE-SCOPED: a key created while the store was in test mode only ever
# returns test data, and a live key cannot see test products.
LEMONSQUEEZY_API_KEY=
# The numeric store id from Settings » Stores. Valice Press is 473583.
LEMONSQUEEZY_STORE_ID=
# The signing secret you typed when creating the webhook (6-40 chars).
# NOT the webhook's id. Requests are HMAC-SHA256 hex over the raw body.
LEMONSQUEEZY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Object Storage — Cloudflare R2 (Roadmap ADR-6, zero-egress)
# TWO private buckets per environment: source masters + per-order
# watermarked artifacts (Roadmap §9 architecture diagram).
# Use a unique bucket pair for Preview / Staging / Production.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=                          # e.g. https://<account>.r2.cloudflarestorage.com
R2_BUCKET_MASTERS=bookstore-masters-dev        # private — uploaded source PDFs (never public)
R2_BUCKET_ARTIFACTS=bookstore-artifacts-dev    # private — per-order watermarked PDFs
# Optional: public R2 URL prefix for serving book covers and other public
# assets (NOT the private masters/artifacts buckets — those are always
# accessed via signed URLs). Example values:
#   https://files.your-domain.com               (custom CDN domain)
#   https://pub-<hash>.r2.dev                    (Cloudflare R2 dev URL pattern)
# When set AND `books.cover_key` is populated, covers render via Next/Image
# at `${R2_PUBLIC_BASE_URL}/${cover_key}`. Falls back to the typographic
# placeholder when unset. Used by `getCoverImageUrl()` in `src/lib/seo.ts`.
R2_PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# Async Jobs — Inngest (preferred per Roadmap §9) OR Vercel Queues (native)
# Drives the watermarking pipeline (Roadmap ADR-3).
# -----------------------------------------------------------------------------
# --- Option A: Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Option B: Vercel Queues ---
# When using Vercel Queues, no manual env vars are required — the runtime
# injects connection details once the queue is provisioned in the project.


# -----------------------------------------------------------------------------
# Upstash Redis (SUB-PR 4.2 — rate limiting + edge-friendly cache backend)
# -----------------------------------------------------------------------------
# REST-based Redis (works on Vercel Edge / Fluid Compute / Node identically).
# Drives the global rate limiter wired in src/proxy.ts via `@upstash/ratelimit`.
#
# Graceful degradation: if either var below is unset, the rate limiter is
# DISABLED — every request passes through with a single `console.warn` at
# process start. The site does not 500 just because Upstash is missing.
#
# Provisioning: console.upstash.com → Redis → Create Database →
#   • Name: bookstore-prod (use a separate DB per environment)
#   • Type: Regional (cheaper) or Global (multi-region)
#   • Eviction: noeviction (rate-limit data is tiny; we don't want it evicted)
# After creation, "REST API" tab exposes:
#   UPSTASH_REDIS_REST_URL    — https://<region>-<id>.upstash.io
#   UPSTASH_REDIS_REST_TOKEN  — long opaque token (server-only secret)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# Transactional Email — Resend (preferred) or Postmark (Roadmap §9)
# Used for "your book is ready", receipts, and (with Auth.js) magic links.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Digital Bookstore <noreply@your-domain.com>

# Newsletter audience id (Resend → Audiences → copy the audience id).
# Powers `POST /api/newsletter` (Phase 0.C). When missing, the route
# returns 503 so the cinematic newsletter forms surface a real error
# rather than a fake success.
RESEND_AUDIENCE_ID=


# -----------------------------------------------------------------------------
# Observability — Sentry (Roadmap §12)
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                    # only required for source-map upload at build
SENTRY_ORG=
SENTRY_PROJECT=


# -----------------------------------------------------------------------------
# Codex Enigmatica — final-answer verification (`/codex-enigmatica/verify`)
#
# The printed book tells its reader that the last question's answer is
# "printed nowhere in this book" and must be entered on a verification page
# whose address is on the last leaf. These two variables are that page's
# entire knowledge of the answer.
#
# ⚠ THE ANSWER ITSELF MUST NEVER BE STORED. Not here, not in the repo, not
# in a comment. What is stored is a PEPPERED SHA-256 digest:
#
#     digest = sha256( PEPPER + "\0" + normalized(answer) )
#
# where `normalized` is uppercase-and-strip-to-A-Z (the book's own printed
# normalization contract: "levels case, spacing and punctuation").
#
# The pepper is what makes this safe. The answer is five letters; a bare
# SHA-256 of a five-letter word is exhaustible in under a second (26^5 =
# 11.9M). With a long random pepper that is not in the attacker's search
# space, it is not.
#
# GENERATING THE PAIR — run this and paste the two lines it prints. The
# answer is read from stdin so it never lands in shell history or a file:
#
#     node scripts/codex-verify-digest.mjs
#
# Both are server-only (no NEXT_PUBLIC_ prefix), so Next never inlines
# them into the client bundle. When either is missing the endpoint answers
# 503 — it FAILS CLOSED and never accepts an answer it cannot check.
#
# NOTE: this endpoint also requires UPSTASH_* above. Its dedicated rate
# limiter (5/min, 20/hour per IP) also fails closed — an unmetered
# verification endpoint is a brute-force oracle.
# -----------------------------------------------------------------------------
CODEX_VERIFY_PEPPER=
CODEX_VERIFY_DIGEST=

# ---------------------------------------------------------------------------
# /bonus — THE FIRST FROST lead magnet (MailerLite + BookFunnel)
# ---------------------------------------------------------------------------
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
MAILERLITE_API_TOKEN=
# The MailerLite group that receives the Larkspur Lake bonus.
MAILERLITE_GROUP_ID=
# Public by necessity — the browser navigates here after subscribing.
# Unset means the form refuses to collect an address rather than sending
# anyone to an invalid destination.
# MUST be set in the BUILD environment: /bonus is statically prerendered, so
# this value is inlined at build time. Setting it only at runtime has no effect,
# and changing it requires a redeploy.
NEXT_PUBLIC_BOOKFUNNEL_URL=
