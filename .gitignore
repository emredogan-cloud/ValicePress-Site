# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the schema template MUST be committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — machine-local permission grants (per developer, never shared)
.claude/settings.json
.claude/settings.local.json

# fulfillment audit log (local-dev only; production uses console.log + Vercel logs)
/logs

# pdf.js worker — copied from node_modules by scripts/copy-pdf-worker.mjs at install time
/public/pdf.worker.min.mjs

# design-reference screenshots placed at the project root (working files;
# not source-of-truth in Git — they live next to the live design instead)
/*-referans-image.png
/*_referans_image.png
/*-reference-image.png
/*_reference_image.png
/*_referance_image.png
# Same screenshots when relocated under /images/ (local-only, never shared)
/images/*-referans-image.png
/images/*_referans_image.png
/images/*-reference-image.png
/images/*_reference_image.png
/images/*_referance_image.png
scripts/tmp/

# Founder-supplied dashboard screenshots (KDP, Resend, Paddle).
# Evidence for a verification session, not source. They show account
# interiors and a personal profile photo, so they stay out of the repo.
/e-book/
/resend.png

# Factory asset drop folder (covers, wraps, interiors are large binaries; the
# storefront webp derived from them IS committed under public/images/books/)
/assets/*
!/assets/.gitkeep
/assets/.image-ledger.json

# Google Cloud service-account keys (Search Console export, ADR: SEO tooling).
# A private key must never enter the repository. Since 2026-09-19 the key no
# longer lives here at all: it was moved to ~/.valice-credentials/ (mode 0700)
# and scripts/seo/* read its path from GOOGLE_SERVICE_ACCOUNT_KEY_FILE. These
# patterns stay so a re-downloaded key cannot be staged by accident.
/valice-press-*.json
/*-service-account*.json
gcp-*.json

# Founder-supplied dashboard screenshots dropped in the root (Search Console,
# Analytics). Same rule as resend.png: evidence, not source.
/seo.png

# Python venv for the print factory (reportlab, pikepdf, segno, fontTools).
# Recreate with: python3 -m venv .venv-factory && .venv-factory/bin/pip install pypdf pikepdf segno reportlab fonttools Pillow
#
# NO TRAILING SLASH. A git worktree keeps one venv by SYMLINKING to the main
# tree's, and `.venv-factory/` matches only a real directory, so the symlink
# showed up as untracked in every worktree and was one careless `git add` away
# from being committed as a link into another checkout.
.venv-factory

# Python bytecode from the OCR tooling
scripts/factory/ocr/__pycache__/
scripts/factory/__pycache__/

# Google OAuth client secrets.
#
# One of these is sitting untracked in the repo root right now, in a PUBLIC
# repository, matched by nothing. `git add -A` would have published it. The
# file itself is left alone — it belongs to whoever put it there — but it can
# no longer be staged by accident.
client_secret_*.json

# Search Console domain-verification exports. Google names them
# `google.com!<property>!<from>!<to>.zip`; they carry verification tokens for a
# property this repository does not own the DNS for. Untracked and matched by
# nothing until 2026-09-19 — one `git add -A` from publication in a PUBLIC repo.
google.com!*.zip

# Ad-hoc desktop screenshots dropped into the tree while working (KDP, Vercel,
# Clerk, Amazon Ads console interiors). Same rule as seo.png and resend.png:
# evidence for one session, never source.
/Screenshot from *.png
/images/Screenshot from *.png
/images/all-companion-page.png
